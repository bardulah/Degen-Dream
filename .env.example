# API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ODDS_API_KEY=your_odds_api_key_here

# Agent Configuration
NUM_SHARPS=3
NUM_INSIDERS=2
NUM_DEGENS=3
NUM_BOOKIES=2

# Simulation Settings
STARTING_BANKROLL=10000
SIMULATION_GAMES=100
KELLY_FRACTION=0.25

# Data Sources
ODDS_API_BASE_URL=https://api.the-odds-api.com/v4
NIKE_SCRAPER_ENABLED=true

# Monetization
STRIPE_API_KEY=your_stripe_key_here
PRO_SUBSCRIPTION_PRICE=9.00
CURRENCY=EUR

# GUI Settings
STREAMLIT_PORT=8501
ENABLE_PYGAME_VISUALIZATION=true

# Logging
LOG_LEVEL=INFO
LOG_FILE=bratislava_syndicate.log
